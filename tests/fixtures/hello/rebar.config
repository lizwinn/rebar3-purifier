%% A single application with Hex dependencies (cowboy brings cowlib and
%% ranch), a git dependency in the test profile, Hex plugins, an escript,
%% a release and a Hex package.
{erl_opts, [debug_info]}.

{deps, [
    {jsx, "3.1.0"},
    {cowboy, "2.12.0"}
]}.

{project_plugins, [erlfmt, rebar3_hex]}.

{escript_main_app, hello}.
{escript_emu_args, "%%! -noshell\n"}.

{relx, [
    {release, {hello, "0.1.0"}, [hello]},
    {dev_mode, false},
    {include_erts, true}
]}.

{profiles, [
    {test, [
        {deps, [
            {meck, {git, "https://github.com/eproxus/meck.git", {tag, "1.0.0"}}}
        ]}
    ]},
    {prod, [{relx, [{mode, prod}]}]}
]}.
